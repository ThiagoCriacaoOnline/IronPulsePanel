    Role: { name: string, slug: string, description: 'text nullable', is_active: 'boolean default:true', is_system: 'boolean default:false', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
