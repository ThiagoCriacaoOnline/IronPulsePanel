    SupportTicket: { protocol_number: 'string:30 unique', requester_type: 'enum:professional,student', requester_id: unsignedBigInteger, related_professional_id: 'id:professional_profile nullable', related_student_id: 'id:student nullable', category: 'enum:financial_dispute,verification_issue,abuse_report,technical_bug,lgpd_request', priority: 'enum:low,medium,high,urgent default:medium', status: 'enum:open,in_progress,waiting_user,resolved,closed default:open', subject: 'string:150', description: text, assigned_to: 'id:user nullable', resolved_at: 'timestamp nullable', resolved_by: 'id:user nullable', resolution_notes: 'text nullable', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
    ApiAccessLog: { portal: 'enum:student_app,professional_panel,website', actor_type: 'enum:student,professional,guest default:guest', actor_id: 'unsignedBigInteger nullable', method: 'string:10', endpoint: 'string:255', status_code: integer, response_time_ms: integer, ip_address: 'string:45 nullable', created_at: timestamp }
    Rating: { professional_student_id: 'id:professional_student', reviewer_type: 'enum:student,professional', reviewer_id: 'unsignedBigInteger index', reviewed_type: 'enum:student,professional', reviewed_id: 'unsignedBigInteger index', score: unsignedTinyInteger, comment: 'text nullable', tags: 'json nullable', moderation_status: 'enum:published,hidden_by_moderation,reported default:published', moderated_at: 'timestamp nullable', moderated_by: 'id:user nullable', moderation_reason: 'text nullable', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
