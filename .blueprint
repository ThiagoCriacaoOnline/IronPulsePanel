    ProfessionalProfile: { name: 'string:150', email: 'string:150 unique', password: 'string:255', cpf_cnpj: 'string:20 unique', email_verified_at: 'timestamp nullable', avatar: 'string:255 nullable', path_avatar: 'string:255 nullable', profession_type: 'enum:nutritionist,personal,both', council_type: 'enum:crn,cref', council_number: 'string:20', council_state: 'string:2', verification_status: 'enum:pending,approved,rejected default:pending', verified_at: 'timestamp nullable', verified_by: 'id:user nullable', rejection_reason: 'text nullable', average_rating: 'decimal:3,2 default:5.00', ratings_count: 'integer default:0', bio: 'text nullable', is_accepting_students: 'boolean default:false', is_active: 'boolean default:true', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
