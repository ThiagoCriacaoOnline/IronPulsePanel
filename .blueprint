    ProfessionalStudent: { professional_profile_id: 'id:professional_profile', student_id: 'id:student', service_type: 'enum:training,nutrition,both', status: 'enum:pending,active,paused,ended default:pending', started_at: 'timestamp nullable', ended_at: 'timestamp nullable', ended_by_type: 'enum:student,professional,backoffice nullable', ended_by_id: 'unsignedBigInteger nullable', end_reason: 'string:255 nullable', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
