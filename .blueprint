    ProfessionalSpecialty: { professional_profile_id: 'id:professional_profile', specialty_id: 'id:specialty', created_at: timestamp, created_by: 'id:user nullable', deleted_at: 'timestamp nullable', deleted_by: 'id:user nullable' }
    ProfessionalContact: { professional_profile_id: 'id:professional_profile unique', whatsapp: 'string:20 nullable', phone: 'string:20 nullable', public_email: 'string:150 nullable', instagram: 'string:100 nullable', twitter: 'string:100 nullable', linkedin: 'string:100 nullable', tiktok: 'string:100 nullable', kawai: 'string:100 nullable', facebook: 'string:100 nullable', website: 'string:255 nullable', city: 'string:100 nullable', state: 'string:2 nullable', attendance_mode: 'enum:online,in_person,both default:online', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
    ProfessionalPayoutSettings: { professional_profile_id: 'id:professional_profile unique', payout_mode: 'enum:direct_pix,platform_intermediation default:platform_intermediation', pix_key_type: 'enum:cpf,cnpj,email,phone,random nullable', pix_key: 'string:150 nullable', pix_holder_name: 'string:150 nullable', pix_holder_document: 'string:20 nullable', custom_fee_percentage: 'decimal:5,2 nullable', fee_terms_accepted_at: 'timestamp nullable', fee_terms_version: 'string:20 nullable', is_payout_blocked: 'boolean default:false', blocked_reason: 'text nullable', blocked_at: 'timestamp nullable', blocked_by: 'id:user nullable', timestamps: timestamps, softdeletes: softDeletes, created_by: 'id:user nullable', updated_by: 'id:user nullable', deleted_by: 'id:user nullable' }
